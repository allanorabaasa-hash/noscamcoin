{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "760px", "wideSize": "1200px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Night", "color": "#04030f" },
				{ "slug": "contrast", "name": "Starlight", "color": "#e2e0ff" },
				{ "slug": "accent-1", "name": "Purple", "color": "#7c3aed" },
				{ "slug": "accent-2", "name": "Cyan", "color": "#06b6d4" },
				{ "slug": "accent-3", "name": "Card", "color": "#0f0d1f" },
				{ "slug": "accent-4", "name": "Muted", "color": "#7c7aa8" },
				{ "slug": "accent-5", "name": "Card light", "color": "#13112a" },
				{ "slug": "accent-6", "name": "Lilac", "color": "#c084fc" },
				{ "slug": "pink", "name": "Pink", "color": "#ec4899" },
				{ "slug": "green", "name": "Green", "color": "#10b981" },
				{ "slug": "amber", "name": "Amber", "color": "#f59e0b" },
				{ "slug": "white", "name": "White", "color": "#ffffff" }
			],
			"gradients": [
				{ "slug": "nsc", "name": "NOSCAM", "gradient": "linear-gradient(135deg,#7c3aed 0%,#2563eb 55%,#06b6d4 100%)" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "manrope",
					"name": "Manrope",
					"fontFamily": "Manrope, system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Manrope", "fontStyle": "normal", "fontWeight": "200 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/Manrope-Variable.woff2" ] }
					]
				},
				{
					"slug": "unbounded",
					"name": "Unbounded",
					"fontFamily": "Unbounded, Manrope, system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Unbounded", "fontStyle": "normal", "fontWeight": "200 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/Unbounded-Variable.woff2" ] }
					]
				},
				{
					"slug": "jetbrains-mono",
					"name": "JetBrains Mono",
					"fontFamily": "\"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
					"fontFace": [
						{ "fontFamily": "JetBrains Mono", "fontStyle": "normal", "fontWeight": "100 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/JetBrainsMono-Variable.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.05rem" },
				{ "slug": "large", "name": "Large", "size": "1.4rem", "fluid": { "min": "1.2rem", "max": "1.4rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2rem", "fluid": { "min": "1.6rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "2.8rem", "fluid": { "min": "2rem", "max": "2.8rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw", "vh" ]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--manrope)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.7" },
		"spacing": {
			"blockGap": "1.2rem",
			"padding": { "left": "clamp(1rem, 4vw, 2rem)", "right": "clamp(1rem, 4vw, 2rem)", "top": "0", "bottom": "0" }
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent-6)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent-2)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--white)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--unbounded)", "fontWeight": "700", "lineHeight": "1.2", "letterSpacing": "-0.01em" }
			},
			"button": {
				"color": { "background": "var(--wp--preset--gradient--nsc)", "text": "var(--wp--preset--color--white)" },
				"border": { "radius": "10px" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--unbounded)", "fontWeight": "700", "fontSize": "0.8rem", "letterSpacing": "0.04em" }
			}
		},
		"blocks": {
			"core/code": { "typography": { "fontFamily": "var(--wp--preset--font-family--jetbrains-mono)" } },
			"core/post-title": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "front-page", "title": "NOSCAM full-width page", "postTypes": [ "page" ] }
	]
}
